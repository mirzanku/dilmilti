MONGODB_URI="mongodb://mirzansyahrir_db_user:L4jj7ql93P0b33fZ@ac-mgykubb-shard-00-00.yza950y.mongodb.net:27017,ac-mgykubb-shard-00-01.yza950y.mongodb.net:27017,ac-mgykubb-shard-00-02.yza950y.mongodb.net:27017/dilmilti5_db?ssl=true&replicaSet=atlas-93ald4-shard-0&authSource=admin"
